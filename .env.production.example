# Copy this file to .env.production on the Oracle VM. Never commit that file.
# Use a URL-safe password (for example: openssl rand -hex 32) because the same
# value is embedded in DATABASE_URL.
POSTGRES_DB=stock_analysis
POSTGRES_USER=stock_app
POSTGRES_PASSWORD=replace_with_a_long_random_hex_value
DATABASE_URL=postgresql+asyncpg://stock_app:replace_with_a_long_random_hex_value@postgres:5432/stock_analysis
REDIS_URL=redis://redis:6379/0

# Production authentication requires a stable public HTTPS origin and real SMTP.
APP_ENVIRONMENT=production
PUBLIC_BASE_URL=https://api.example.com
MAILER_BACKEND=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_me
SMTP_PASSWORD=replace_with_an_app_password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME="Stock Analysis Platform"
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# Authentication throttling. Keep fail-open disabled in production.
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REGISTRATION_SOURCE=10
AUTH_RATE_LIMIT_REGISTRATION_EMAIL=3
AUTH_RATE_LIMIT_LOGIN_SOURCE=30
AUTH_RATE_LIMIT_LOGIN_EMAIL=10
AUTH_RATE_LIMIT_VERIFICATION_RESEND_SOURCE=10
AUTH_RATE_LIMIT_VERIFICATION_RESEND_EMAIL=3
AUTH_RATE_LIMIT_RECOVERY_SOURCE=10
AUTH_RATE_LIMIT_RECOVERY_EMAIL=3
AUTH_RATE_LIMIT_FAIL_OPEN=false

POLYGON_API_KEY=replace_me
ANTHROPIC_API_KEY=
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# Exact, comma-separated HTTPS origins allowed to call the API.
CORS_ORIGINS=https://your-project.vercel.app,https://app.example.com

# A DNS hostname whose A record points to the reserved OCI public IP.
API_DOMAIN=api.example.com

# Session/CSRF are intentionally fixed application contracts, not secrets:
# cookie __Host-session (Secure, HttpOnly, SameSite=Lax, Path=/), 30-day
# absolute server-side session, and X-CSRF-Token on state-changing requests.
