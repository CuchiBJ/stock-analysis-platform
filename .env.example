# Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stock_analysis
REDIS_URL=redis://localhost:6379/0
POLYGON_API_KEY=your_polygon_api_key
CORS_ORIGINS=http://localhost:3000
APP_ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:3000
AUTH_PUBLIC_ACCOUNT_FLOWS_ENABLED=true
MAILER_BACKEND=capture

# Optional local SMTP override. Production must use SMTP over TLS and a public
# HTTPS PUBLIC_BASE_URL; see .env.production.example.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM_EMAIL=no-reply@example.test

# IBKR Flex auto-sync (optional) — when both are set, the journal pulls executed
# trades from IBKR automatically (Sync IBKR button + nightly scheduler job).
# Generate in IBKR Account Management → Reports → Flex Queries:
#   - Flex Web Service → token
#   - an Activity Flex Query that includes the Trades/Executions section → query id
# IBKR_FLEX_TOKEN=your_flex_token
# IBKR_FLEX_QUERY_ID=your_query_id

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_PUBLIC_ACCOUNT_FLOWS_ENABLED=true
